# Which XO release to package: stable or latest (the channel badges in upstream's
# CHANGELOG.md). XO_VERSION=X.Y.Z pins an exact release and wins over the channel.
# Both can be overridden with `build.sh --channel ... / --version ...`.
XO_CHANNEL=${XO_CHANNEL:-stable}
XO_VERSION=${XO_VERSION:-}
# Must satisfy XO's engines (node >=14.18); use a current LTS.
NODE_VERSION=22.11.0
# Bump when repackaging the same XO/Node versions.
PKG_REVISION=1
