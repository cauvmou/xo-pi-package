#!/bin/sh
set -e

case "$1" in
configure)
    mkdir -p /var/lib/xo-server
    # Service runs as root: NFS/CIFS/VHD backup mounts require it.
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable xen-orchestra.service >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        systemctl restart xen-orchestra.service >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
